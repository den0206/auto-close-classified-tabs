        }
      },
      {
        "id": "autoCloseClassifiedTabs.css",
        "description": "%color.css%",
        "defaults": {
          "dark": "#9E6ECF",
          "light": "#663399"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.xml",
        "description": "%color.xml%",
        "defaults": {
          "dark": "#3DA9FF",
          "light": "#0060AC"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/*.test.js scripts/*.test.js",
    "test:e2e": "npm run compile && vscode-test",
    "package": "node -e \"require('node:fs').mkdirSync('vsix',{recursive:true})\" && vsce package --out vsix/auto-close-classified-tabs.vsix",
    "clean": "rm -rf out vsix .vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.88.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
