{
  "name": "auto-close-classified-tabs",
  "displayName": "Auto Close Classified Tabs",
  "description": "%extension.description%",
  "version": "0.0.2",
  "publisher": "yuuki-sakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/auto-close-classified-tabs"
  },
  "engines": {
    "vscode": "^1.88.0",
    "node": ">=20"
  },
  "galleryBanner": {
    "color": "#4F46E5",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tabs",
    "editor",
    "close",
    "color",
    "productivity"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "autoCloseClassifiedTabs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enabled.description%"
        },
        "autoCloseClassifiedTabs.maxTabs": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "%configuration.maxTabs.description%"
        },
        "autoCloseClassifiedTabs.maxTabsByType": {
          "type": "object",
          "default": {
            "diff": 1
          },
          "propertyNames": {
            "enum": [
              "diff",
              "test",
              "generated",
              "docs",
              "json",
              "yaml",
              "toml",
              "env",
              "sql",
              "shell",
              "docker",
              "typescript",
              "javascript",
              "dart",
              "python",
              "go",
              "rust",
              "jvm",
              "swift",
              "ruby",
              "php",
              "cfamily",
              "csharp",
              "html",
              "css",
              "xml"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "markdownDescription": "%configuration.maxTabsByType.description%",
          "examples": [
            {
              "diff": 1,
              "generated": 1,
              "docs": 2
            }
          ]
        },
        "autoCloseClassifiedTabs.closeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.closeOnStartup.description%"
        },
        "autoCloseClassifiedTabs.closePreviewFirst": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.closePreviewFirst.description%"
        },
        "autoCloseClassifiedTabs.colors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.colors.enabled.description%"
        },
        "autoCloseClassifiedTabs.colors.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%configuration.colors.rules.description%",
          "examples": [
            {
              ".proto": "sql",
              "docs/": "docs"
            }
          ]
        }
      }
    },
    "commands": [
      {
        "command": "autoCloseClassifiedTabs.closeUnused",
        "title": "%command.closeUnused.title%",
        "category": "%extension.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "autoCloseClassifiedTabs.toggleProtect",
        "title": "%command.toggleProtect.title%",
        "category": "%extension.category%",
        "icon": "$(pin)"
      },
      {
        "command": "autoCloseClassifiedTabs.enableTabDecorations",
        "title": "%command.enableTabDecorations.title%",
        "category": "%extension.category%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "autoCloseClassifiedTabs.restoreDecorationDefaults",
        "title": "%command.restoreDecorationDefaults.title%",
        "category": "%extension.category%"
      },
      {
        "command": "autoCloseClassifiedTabs.applyLabelIcons",
        "title": "%command.applyLabelIcons.title%",
        "category": "%extension.category%"
      },
      {
        "command": "autoCloseClassifiedTabs.removeLabelIcons",
        "title": "%command.removeLabelIcons.title%",
        "category": "%extension.category%"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "autoCloseClassifiedTabs.toggleProtect",
          "group": "1_close@99"
        }
      ]
    },
    "colors": [
      {
        "id": "autoCloseClassifiedTabs.diff",
        "description": "%color.diff%",
        "defaults": {
          "dark": "#89D2AD",
          "light": "#2A6F4D"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.test",
        "description": "%color.test%",
        "defaults": {
          "dark": "#C678DD",
          "light": "#8B5CF6"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.generated",
        "description": "%color.generated%",
        "defaults": {
          "dark": "#6B7280",
          "light": "#9CA3AF"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.docs",
        "description": "%color.docs%",
        "defaults": {
          "dark": "#4685F6",
          "light": "#083FA1"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.json",
        "description": "%color.json%",
        "defaults": {
          "dark": "#C3E88D",
          "light": "#3F7A16"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.yaml",
        "description": "%color.yaml%",
        "defaults": {
          "dark": "#4ED0B6",
          "light": "#0B846C"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.toml",
        "description": "%color.toml%",
        "defaults": {
          "dark": "#A9CCA4",
          "light": "#37762D"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.env",
        "description": "%color.env%",
        "defaults": {
          "dark": "#EE63D7",
          "light": "#9C0D84"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.sql",
        "description": "%color.sql%",
        "defaults": {
          "dark": "#ABD0E3",
          "light": "#07567E"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.shell",
        "description": "%color.shell%",
        "defaults": {
          "dark": "#8FE25B",
          "light": "#57AD1F"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.docker",
        "description": "%color.docker%",
        "defaults": {
          "dark": "#7CAFC0",
          "light": "#2E525F"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.typescript",
        "description": "%color.typescript%",
        "defaults": {
          "dark": "#649BD9",
          "light": "#2863A4"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.javascript",
        "description": "%color.javascript%",
        "defaults": {
          "dark": "#EF6CAD",
          "light": "#9C1157"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.dart",
        "description": "%color.dart%",
        "defaults": {
          "dark": "#3DFFF5",
          "light": "#00B4AB"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.python",
        "description": "%color.python%",
        "defaults": {
          "dark": "#6CA3D0",
