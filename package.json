        }
      },
      {
        "id": "autoCloseClassifiedTabs.ruby",
        "description": "%color.ruby%",
        "defaults": {
          "dark": "#A38CD9",
          "light": "#5430A6"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.php",
        "description": "%color.php%",
        "defaults": {
          "dark": "#7C8AC0",
          "light": "#42518A"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.cfamily",
        "description": "%color.cfamily%",
        "defaults": {
          "dark": "#E0B3BF",
          "light": "#99334E"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.csharp",
        "description": "%color.csharp%",
        "defaults": {
          "dark": "#7A5EDF",
          "light": "#4022AA"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.html",
        "description": "%color.html%",
        "defaults": {
