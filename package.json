        }
      },
      {
        "id": "autoCloseClassifiedTabs.javascript",
        "description": "%color.javascript%",
        "defaults": {
          "dark": "#EBD94F",
          "light": "#8A7300"
        }
      },
      {
        "id": "autoCloseClassifiedTabs.dart",
